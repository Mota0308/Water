# 本機 MongoDB Compass / 本機 mongod
# 範例：mongodb://127.0.0.1:27017/store-work-flow
# Railway：使用 Railway 提供的 MongoDB 連線字串
MONGODB_URI=mongodb://127.0.0.1:27017/store-work-flow
MONGODB_DB_NAME=store-work-flow

# 種子系統管理員（npm run seed）
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=系統管理員
