PORT=8080
# Atlas connection string (password URL-encoded if it has special chars)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=store_employee
MAX_UPLOAD_MB=15
# 檔案上載：預設 MongoDB GridFS。若要改回優先 Google Drive，設 FILE_STORAGE=google-drive
# FILE_STORAGE=mongodb

# Google Drive（可選：匯出用戶等；需與服務帳戶共用資料夾為編輯者）
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id
# GOOGLE_DRIVE_USERS_FILE_ID=1WkFU5XmnNxwxWGtByeZcWlPcv9crc1pD
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...整段一行...}
